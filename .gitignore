# TLS cert/key — self-signed, provisioned onto a Docker volume outside Git.
# See frontend/certs/README.md and edge-nginx/certs/README.md.
frontend/certs/*.pem
edge-nginx/certs/*.pem

# Standard Node/build artifacts (not currently all excluded — see note in
# conversation about node_modules already being tracked from an earlier commit)
node_modules/
dist/
.env
.env.local

# Portainer API access token — grants full control over the Docker host.
apiaccesstoken.key

# Local secrets folder — contents never committed (see secrets/README.md).
secrets/*
!secrets/.gitignore
!secrets/README.md
