PORT=4000
DATABASE_URL=postgres://prism:prism@db:5432/prism
SESSION_SECRET=prism_dev_secret
CORS_ORIGIN=http://localhost:5173

# Entra ID (Azure AD) SSO — optional. Leave blank to keep OTP-only login.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:4000/api/auth/entra/callback

# Database snapshots (weekly auto-snapshot, manual export/import, rollback)
SNAPSHOT_DIR=/app/data/snapshots
SNAPSHOT_RETENTION_WEEKLY=12
SNAPSHOT_RETENTION_SAFETY=5
SNAPSHOT_MAX_UPLOAD_MB=500
