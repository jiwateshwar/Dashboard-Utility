PORT=4000
DATABASE_URL=postgres://prism:prism@db:5432/prism
SESSION_SECRET=prism_dev_secret
CORS_ORIGIN=http://localhost:5173

# Entra ID (Azure AD) SSO — optional, and only used to seed the very first
# run. After that it's configured from the app itself: log in as a
# SuperAdmin and open "SSO Settings" to set these, test the connection, and
# go live. Leave blank to keep OTP-only login.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:4000/api/auth/entra/callback

# Database snapshots (weekly auto-snapshot, manual export/import, rollback)
SNAPSHOT_DIR=/app/data/snapshots
SNAPSHOT_RETENTION_WEEKLY=12
SNAPSHOT_RETENTION_SAFETY=5
SNAPSHOT_MAX_UPLOAD_MB=500

# Email notifications — optional, and only used to seed the very first run
# (same as Entra above). After that, configure it from the app: log in as a
# SuperAdmin → "Email Settings", send a test email, then go live.
# Never commit real credentials; keep them in secrets/ (git-ignored).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=PRISM
# Base URL used for links inside emails (defaults to the first non-IP CORS origin).
APP_BASE_URL=
# Timezone for the daily digest (08:30 weekdays) and weekly summary (Mon 09:00).
NOTIFY_TZ=Asia/Kolkata
